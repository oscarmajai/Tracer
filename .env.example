# Copia este archivo a .env y ajusta los valores antes de arrancar
# cp .env.example .env
#
# El backend NO arranca si faltan TRACER_API_TOKEN, TRACER_USERNAME o TRACER_PASSWORD.

# Credenciales del panel web (login)
TRACER_USERNAME=admin
TRACER_PASSWORD=CambiaEstaContrasena

# Token interno de la API. El login devuelve este valor; Android lo usa como Bearer.
# Generá uno con: openssl rand -hex 32
TRACER_API_TOKEN=CambiaEsteTokenPorUnoSeguro

# ── Opcionales (tienen valor por defecto) ────────────────────────────────────
# Puerto donde escucha el backend Go (en Docker lo fija docker-compose a 3000).
#PORT=3000

# Rutas de datos. En Docker las fija docker-compose bajo /data (volumen persistente).
#TRACER_DB_FILE=./telemetry.db
#TRACER_PHOTOS_DIR=./photos
#TRACER_AUDIO_DIR=./audio
