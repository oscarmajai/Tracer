# Copia este archivo a .env y ajusta los valores antes de arrancar
# cp .env.example .env

# Credenciales del panel web
TRACER_USERNAME=admin
TRACER_PASSWORD=CambiaEstaContrasena

# Token interno de la API (lo genera el servidor al hacer login)
TRACER_API_TOKEN=CambiaEsteTokenPorUnoSeguro

# Puerto donde escucha nginx (debe coincidir con el tunnel de Cloudflare)
# Si tu tunnel apunta a localhost:80, déjalo en 80
# Si configuraste el tunnel en otro puerto (ej. 100), cambia el mapeo en docker-compose.yml
