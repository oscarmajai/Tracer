<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tracer"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Servicio activo"
            android:textColor="#4CAF50"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESTADO"
                android:textSize="11sp"
                android:textColor="#9E9E9E"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ubicación"
                    android:textSize="13sp"
                    android:textColor="#757575" />
                <TextView
                    android:id="@+id/tvLastLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="–"
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enviada"
                    android:textSize="13sp"
                    android:textColor="#757575" />
                <TextView
                    android:id="@+id/tvLastTimestamp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="–"
                    android:textSize="13sp"
                    android:textColor="#212121" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Servidor"
                    android:textSize="13sp"
                    android:textColor="#757575" />
                <TextView
                    android:id="@+id/tvLastResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="–"
                    android:textSize="13sp"
                    android:textColor="#212121" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Último sondeo"
                    android:textSize="13sp"
                    android:textColor="#757575" />
                <TextView
                    android:id="@+id/tvLastPoll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="–"
                    android:textSize="13sp"
                    android:textColor="#212121" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Último comando"
                    android:textSize="13sp"
                    android:textColor="#757575" />
                <TextView
                    android:id="@+id/tvLastCommand"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="–"
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:fontFamily="monospace" />
            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnForceLocate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enviar ubicación ahora"
            android:layout_marginBottom="28dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp" />

        <!-- PIN section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIN de comandos SMS"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etPin"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textSize="28sp"
            android:gravity="center"
            android:maxLength="8"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSavePin"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:text="Guardar PIN"
            android:layout_marginBottom="28dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comandos disponibles"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PIN LOCATE\nPIN ALERT ON|OFF\nPIN RING [STOP]\nPIN BATTERY\nPIN STATUS\nPIN LOCK"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="#424242"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="28dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp" />

        <!-- Trusted number section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Número de confianza (alertas SIM)"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etTrustedNumber"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:hint="+52 55 1234 5678"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnSaveTrustedNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar número"
            android:layout_marginBottom="28dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="20dp" />

        <!-- Admin section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bloqueo remoto (LOCK)"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvAdminStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● No activado"
            android:textColor="#F44336"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnActivateAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Activar permisos de admin"
            android:layout_marginBottom="8dp"
            android:visibility="visible" />

    </LinearLayout>
</ScrollView>
